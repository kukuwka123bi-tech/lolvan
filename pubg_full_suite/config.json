{
  "module": {
    "id": "pubg_full_suite",
    "name": "PUBG Zygisk Suite",
    "version": "2.0.0",
    "versionCode": 2,
    "author": "dj",
    "description": "Full Zygisk mod suite for PUBG Mobile with dynamic legit/rage profiles."
  },
  "features": {
    "esp": {
      "enabled": true,
      "box": true,
      "skeleton": false,
      "health": true,
      "lines": true,
      "distance": true,
      "name": false
    },
    "aimbot": {
      "enabled": true,
      "fov": 5.0,
      "smooth": 0.1,
      "bone": 0,
      "visibility_check": true,
      "team_check": true
    },
    "weapon": {
      "no_recoil": false,
      "no_spread": false
    },
    "visuals": {
      "ipad_view": false,
      "aspect_ratio": 1.333,
      "wallhack": false,
      "chams": false,
      "glow": false
    },
    "radar": {
      "enabled": false,
      "scale": 100.0
    },
    "skin_changer": {
      "enabled": false,
      "skin_id": 0
    },
    "speed_hack": {
      "enabled": false,
      "multiplier": 1.0
    },
    "auto_fire": {
      "enabled": false
    },
    "bypass": {
      "hide_from_ace": true,
      "anti_screenshot": false
    }
  },
  "profiles": {
    "legit": {
      "esp": {"enabled": true, "skeleton": false},
      "aimbot": {"fov": 3.0, "smooth": 0.08, "bone": 1},
      "weapon": {"no_recoil": false, "no_spread": false},
      "visuals": {"ipad_view": false, "wallhack": false}
    },
    "rage": {
      "esp": {"enabled": true, "skeleton": true},
      "aimbot": {"fov": 180.0, "smooth": 1.0, "bone": 0, "visibility_check": false},
      "weapon": {"no_recoil": true, "no_spread": true},
      "visuals": {"wallhack": true, "chams": true}
    },
    "off": {
      "esp": {"enabled": false},
      "aimbot": {"enabled": false},
      "weapon": {"no_recoil": false, "no_spread": false},
      "visuals": {"wallhack": false, "chams": false}
    }
  },
  "game": {
    "packages": [
      "com.tencent.tmgp.pubgmhd",
      "pubg.krmobile",
      "com.vng.pubgmobile",
      "com.tencent.ig",
      "com.pubg.imobile"
    ],
    "libraries": [
      "libUE4.so",
      "libtersafe.so"
    ]
  },
  "build": {
    "ndk_version": "r26b",
    "cmake_version": "3.18+",
    "abi": "arm64-v8a",
    "platform": "android-26",
    "stl": "c++_static"
  }
}